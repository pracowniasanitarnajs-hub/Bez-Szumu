# Skopiuj do .env.local (lokalnie) i ustaw w Environment Variables na Render.com. NIE commituj prawdziwych kluczy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

CRON_SECRET=
SUPADATA_API_KEY=
YOUTUBE_API_KEY=

AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

BATCH_SIZE=5
AUTO_PUBLISH=true
MIN_DURATION_SECONDS=300

# Haslo do panelu /admin (tymczasowe, do czasu logowania Google/Apple)
ADMIN_PASSWORD=
REVIEW_BELOW_SCORE=4
# Stripe (najpierw klucze testowe sk_test_...). Webhook: https://bez-szumu.pl/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Facebook: codzienny post z rankingiem (token strony = sekret)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
FB_POST_HOUR=8
FB_AUTO_PUBLISH=false
# Adres do zgloszen sprostowan (wyswietlany w stopce, jesli ustawiony)
NEXT_PUBLIC_CONTACT_EMAIL=
